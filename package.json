    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.5",
    "prisma": "^6.19.3",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "qr-scanner": "^1.4.2",
