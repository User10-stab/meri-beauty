// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ENUMS

enum UserRole {
  OWNER
  STAFF
  CUSTOMER
  ADMIN
}

enum StaffType {
  EMPLOYEE
  INDEPENDENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_PAID
}

enum PaymentType {
  ON_SITE
  ONLINE
  DEPOSIT
}

enum TransactionMethod {
  CASH
  CARD
  ONLINE
}

enum TransactionType {
  DEPOSIT
  FINAL_PAYMENT
  REFUND
}

enum ContractType {
  PERCENTAGE
  FIXED_RENT
  HYBRID
}

// Language enum kept for backward compatibility — new code uses Staff.languages as String[]
enum Language {
  ARABIC
  FRENCH
  ENGLISH
  SPANISH
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_PENDING
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum RecipientStatus {
  SENT
  OPENED
  FAILED
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// BOUTIQUE ENUMS

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MovementType {
  SALE
  RESTOCK
  RETURN
  LOSS
  ADJUSTMENT
  SALON_USAGE // product taken from retail stock during a service
}

enum CommissionType {
  PERCENTAGE
  FIXED
  HYBRID
}

// COMMERCE ENUMS

enum CartStatus {
  ACTIVE
  CONVERTED // turned into an Order
  ABANDONED
}

enum FulfilmentMode {
  PICKUP_PREPAID // pay online, collect in salon
  PICKUP_ON_SITE // reserve online, pay at counter on pickup
  SHIPPING_PREPAID // pay online, bpost delivery
}

enum OrderStatus {
  PENDING_PAYMENT // prepaid modes — Stripe checkout started, not yet settled
  PENDING_PICKUP // pickup+pay-on-site — confirmed, stock reserved, awaiting the customer
  PAID // payment settled, not yet fulfilled
  PROCESSING // shipping mode — preparing the parcel
  READY_FOR_PICKUP // staff has set the order aside in the salon
  SHIPPED // handed to bpost, tracking code set
  COMPLETED // picked up, or shipped and closed out
  CANCELLED
  EXPIRED // pay-on-site pickup not collected within the deadline
}

enum WeekDay {
  MONDAY

  TUESDAY

  WEDNESDAY

  THURSDAY

  FRIDAY

  SATURDAY

  SUNDAY
}
enum ReservationConfirmationMode {
  AUTOMATIC
  MANUAL
}

// SALON
model Salon {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  coverImage  String?

  phone       String
  email       String
  address     String?

  instagram   String?
  facebook    String?
  tiktok      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gallery      SalonGallery[]
  workingDays  SalonWorkingDay[]
  closures     SalonClosure[]
  newsletters  Newsletter[]
}
model SalonWorkingDay {
  id           String   @id @default(cuid())

  day          WeekDay
  isOpen       Boolean  @default(true)

  openingTime  String
  closingTime  String

  salonId      String
  salon        Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, day])
}
model SalonClosure {
  id          String   @id @default(cuid())

  title       String

  startDate   DateTime
  endDate     DateTime?

  isFullDay   Boolean @default(true)

  openingTime String?
  closingTime String?

  salonId     String
  salon       Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// USER
model User {
  id                   String    @id @default(cuid())
  fullName             String
  nickName             String?
  email                String    @unique
  password             String
  phone                String    @unique
  role                 UserRole
  avatar               String?
  emailVerified        Boolean   @default(false)
  isActive             Boolean   @default(true)
  lastLogin            DateTime?
  newsletterSubscribed Boolean   @default(false)
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff                Staff?
  appointments         Appointment[]
  reviews              Review[]
  notifications        Notification[]
  newsletterRecipients NewsletterRecipient[]
  createdStaffServices StaffService[]        @relation("CreatedBy")
  rentalRequests       RentalRequest[]
  stockMovements       InventoryMovement[]   @relation("StockMovementBy")
  carts                Cart[]
  orders               Order[]               @relation("OrderBuyer")
  pickedUpOrders       Order[]               @relation("OrderPickedUpBy")
}

// CATEGORY — services only. Retail products use ProductCategory.
model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  services Service[]
}

// ─────────────────────────────────────────────────────────────────────────────
// BOUTIQUE — CATALOGUE
// ─────────────────────────────────────────────────────────────────────────────

// BRAND
// Deliberately carries no category link: a beauty brand spans several
// categories, and a stored copy would only be able to disagree with the
// products themselves. Derive it with a DISTINCT query when needed.
model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logo        String?
  description String?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([isActive, isDeleted])
}

// PRODUCT CATEGORY
model ProductCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories ProductSubcategory[]

  @@index([slug])
}

// PRODUCT SUBCATEGORY
// The "max 4 subcategories per brand" rule is a UI/display constraint and is
// deliberately not enforced here.
model ProductSubcategory {
  id       String @id @default(cuid())
  name     String
  slug     String
  position Int    @default(0)
  isActive Boolean @default(true)

  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// PRODUCT
// Descriptive only — every sellable unit, price and stock level lives on
// ProductVariant, so a product with one size still has exactly one variant.
model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  subcategoryId String
  subcategory   ProductSubcategory @relation(fields: [subcategoryId], references: [id])

  status ProductStatus @default(DRAFT)

  // Never hard-delete: OrderItem references variants of this product forever.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([slug])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([status, isDeleted])
}

// PRODUCT VARIANT
// The sellable unit: "250 ml", "Teinte 03". Carries sku, barcode, prices and stock.
//
// profit and margin are intentionally absent — both are derivations of
// (price - costPrice). Stored, they go stale the moment either input changes
// and leave three fields that can contradict each other. Compute on read.
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name    String // "250 ml", "Teinte 03" — "Standard" for single-variant products
  sku     String  @unique
  barcode String? @unique // EAN/UPC; null until an internal code is generated

  price        Decimal  @db.Decimal(10, 2) // selling price, TVA included
  costPrice    Decimal  @db.Decimal(10, 2) // supplier cost — "prix initial"
  comparePrice Decimal? @db.Decimal(10, 2) // struck-through price — "prix barré"

  // Available to sell = stockQuantity - reservedQuantity.
  // Reservation is NOT an InventoryMovement: it does not change stock on hand,
  // and folding it in would break SUM(quantity) == stockQuantity.
  stockQuantity     Int @default(0)
  reservedQuantity  Int @default(0)
  lowStockThreshold Int @default(3)

  position Int     @default(0)
  isActive Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive, isDeleted])
}

// PRODUCT IMAGE
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  path      String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
}

// INVENTORY MOVEMENT
// Append-only ledger. quantity is signed, so SUM(quantity) reconciles to
// ProductVariant.stockQuantity. Written in the same transaction as the stock
// update, never after it.
model InventoryMovement {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  type     MovementType
  quantity Int // negative for SALE / LOSS / SALON_USAGE, positive for RESTOCK / RETURN

  previousStock Int
  newStock      Int

  reason String?

  createdById String?
  createdBy   User?   @relation("StockMovementBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOUTIQUE — COMMERCE (cart, checkout, orders)
// ─────────────────────────────────────────────────────────────────────────────

// CART
// Identified by a random `token` set in a cookie so a browsing session has a
// cart before the customer is known; `userId` is attached once they log in /
// check out. Never hard-delete CartItems on checkout — the cart is marked
// CONVERTED and left as history, the Order is the new source of truth.
model Cart {
  id String @id @default(cuid())

  token String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([userId])
}

// CART ITEM
model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ORDER
// `orderNumber` is a human-readable display number (gaps are fine — Belgian
// gapless-sequence law applies to invoices, not orders; a separate Invoice
// model will own that numbering). Shipping fields only apply to
// SHIPPING_PREPAID; pickup fields only apply to the two PICKUP_* modes —
// left nullable rather than split into subtype tables since an Order is
// always exactly one fulfilment mode for its whole lifetime.
model Order {
  id          String @id @default(cuid())
  orderNumber Int    @unique @default(autoincrement())

  userId String
  user   User   @relation("OrderBuyer", fields: [userId], references: [id])

  fulfilmentMode FulfilmentMode
  status         OrderStatus    @default(PENDING_PAYMENT)

  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  totalAmount  Decimal @db.Decimal(10, 2)

  // Shipping (SHIPPING_PREPAID)
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingPostalCode String?
  shippingCountry    String?   @default("BE")
  bpostTrackingCode  String?
  shippedAt          DateTime?

  // Pickup (PICKUP_PREPAID / PICKUP_ON_SITE)
  pickupCode        String?   @unique // QR payload scanned by staff at collection
  pickedUpAt        DateTime?
  pickedUpByStaffId String?
  pickedUpByStaff   User?     @relation("OrderPickedUpBy", fields: [pickedUpByStaffId], references: [id])

  // PENDING_PICKUP orders auto-cancel + restock if not collected by this date
  expiresAt     DateTime?
  cancelledAt   DateTime?
  cancelReason  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
}

// ORDER ITEM
// Snapshots product/variant name, sku and unitPrice at time of purchase —
// the variant itself may be repriced or renamed later, but a placed order
// must keep showing what the customer actually bought and paid.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  productName String
  variantName String
  sku         String

  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

// SERVICE
model Service {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices StaffService[]
}

// STAFF
model Staff {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  type               StaffType
  languages          String[]
  bio                String?
  isActive           Boolean   @default(true)
  photo              String?
  hireDate           DateTime?
  yearsOfExperience  Int
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?

  // Reservation Settings
  reservationConfirmationMode ReservationConfirmationMode @default(MANUAL)
  depositEnabled              Boolean @default(false)
  depositPercentage           Decimal @default(10.0) @db.Decimal(5,2)

  // Account Setup
  setupCompleted              Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices StaffService[]
  workingHours  WorkingHour[]
  timeOffs      TimeOff[]
  contracts     Contract[]
}

// StaffService
model StaffService {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  price    Decimal
  duration Int
  margin   Decimal?
  photo    String
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([staffId, serviceId])
}

// APPOINTMENT
model Appointment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  staffServiceId String
  staffService   StaffService @relation(fields: [staffServiceId], references: [id])

  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  payment       Payment?
  review        Review?
  notifications Notification[]
}

// PAYMENT
// Polymorphic: exactly one of appointmentId / orderId is set, enforced by a
// raw-SQL CHECK constraint added after the migration (see
// prisma/migrations/*_add_commerce_cart_order/migration.sql) — Prisma has no
// schema-level XOR. A future workshopReservationId branch can join this same
// CHECK when that module exists.
model Payment {
  id                   String        @id @default(cuid())
  appointmentId        String?       @unique
  appointment          Appointment?  @relation(fields: [appointmentId], references: [id])
  orderId              String?       @unique
  order                Order?        @relation(fields: [orderId], references: [id])
  depositAmount        Decimal       @default(0)
  totalAmount          Decimal
  paidAmount           Decimal
  remainingAmount      Decimal
  paymentType          PaymentType
  status               PaymentStatus
  paidAt               DateTime?
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  transactionReference String?

  transactions Transaction[]
}

// TRANSACTION
model Transaction {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])

  amount          Decimal
  method          TransactionMethod
  transactionType TransactionType
  paidAt          DateTime
  createdAt       DateTime          @default(now())
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
}

// CONTRACT
model Contract {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  type                 ContractType
  commissionPercentage Float?
  fixedRent            Decimal?
  startDate            DateTime
  endDate              DateTime?
  status               ContractStatus
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

// WORKING HOUR
model WorkingHour {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  day       WeekDay
  startTime String
  endTime   String
  isClosed  Boolean @default(false)
}

// TIME OFF
model TimeOff {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  startDate DateTime
  endDate   DateTime
  reason    String?
}

// REVIEW
model Review {
  id String @id @default(cuid())

  userId        String
  appointmentId String @unique

  user        User        @relation(fields: [userId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NOTIFICATION
model Notification {
  id String @id @default(cuid())

  userId        String
  appointmentId String?

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  type    NotificationType
  title   String
  message String

  status    NotificationStatus
  sentAt    DateTime?
  createdAt DateTime           @default(now())
}

// NEWSLETTER
model Newsletter {
  id String @id @default(cuid())

  title       String
  subject     String
  content     String
  status      NewsletterStatus
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  salonId String
  salon   Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  recipients NewsletterRecipient[]
}

// NEWSLETTER RECIPIENT
model NewsletterRecipient {
  id String @id @default(cuid())

  newsletterId String
  userId       String

  newsletter Newsletter @relation(fields: [newsletterId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  status   RecipientStatus
  openedAt DateTime?

  @@unique([newsletterId, userId])
}

// RENTAL REQUEST
model RentalRequest {
  id             String              @id @default(cuid())
  userId         String?
  user           User?               @relation(fields: [userId], references: [id])
  rentalType     String
  startDate      DateTime
  endDate        DateTime?
  commissionType CommissionType
  status         RentalRequestStatus
  message        String?
  ownerResponse  String?
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// SALON GALLERY
model SalonGallery {
  id String @id @default(cuid())

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])

  image     String
  createdAt DateTime @default(now())
}

// PASSWORD RESET TOKEN
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// EMAIL VERIFICATION TOKEN
model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}
