#!/usr/bin/env bash
# Root-owned helper invoked only by the staging-deploy account through sudo.
set -Eeuo pipefail

readonly APP_USER="g21lolpopi"
readonly APP_ROOT="/srv/meribeauty/app"
readonly INCOMING_DIR="${APP_ROOT}/incoming"
readonly RELEASES_DIR="${APP_ROOT}/releases"
readonly ENV_FILE="${APP_ROOT}/staging.env"
readonly SERVICE="meri-staging.service"

release="${1:-}"
if [[ ! "$release" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Expected a full lowercase Git commit SHA." >&2
  exit 64
fi

incoming_release="${INCOMING_DIR}/${release}"
release_dir="${RELEASES_DIR}/${release}"
if [[ ! -f "${incoming_release}/package.json" || ! -f "${incoming_release}/prisma/schema.prisma" ]]; then
  echo "Uploaded staging release is incomplete." >&2
  exit 65
fi
if [[ -e "$release_dir" ]]; then
  echo "Release ${release} already exists; refusing to overwrite it." >&2
  exit 66
fi
if [[ ! -r "$ENV_FILE" ]]; then
  echo "Staging environment file is unavailable." >&2
  exit 67
fi

environment=()
while IFS= read -r assignment || [[ -n "$assignment" ]]; do
  [[ -z "$assignment" || "$assignment" =~ ^[[:space:]]*# ]] && continue
  key="${assignment%%=*}"
  value="${assignment#*=}"
  if [[ "$key" == "$assignment" || ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "Invalid staging environment entry." >&2
    exit 68
  fi
  # systemd EnvironmentFile accepts spaces in unquoted values. Do not source
  # it: shell evaluation both rejects those values and could execute content.
  if [[ "$value" =~ ^\".*\"$ || "$value" =~ ^\'.*\'$ ]]; then
    value="${value:1:${#value}-2}"
  fi
  environment+=("${key}=${value}")
done < "$ENV_FILE"

# A failed install, migration, or build leaves the existing current release running.
mv "$incoming_release" "$release_dir"
chown -R "${APP_USER}:${APP_USER}" "$release_dir"

runuser -u "$APP_USER" -- env "${environment[@]}" bash -lc "
  set -e
  cd '${release_dir}'
  npm ci --legacy-peer-deps
  npx prisma migrate deploy
  npx prisma generate
  npm run build
"

previous_target="$(readlink "${APP_ROOT}/current")"
temporary_link="${APP_ROOT}/.current-${release}"
ln -s "releases/${release}" "$temporary_link"
mv -Tf "$temporary_link" "${APP_ROOT}/current"

systemctl restart "$SERVICE"
healthy=false
for _ in {1..15}; do
  # Staging deliberately has no background scheduler, so /api/health returns
  # 503 by design. Login verifies the running Next server without that signal.
  if curl --fail --silent --show-error --max-time 2 http://127.0.0.1:3000/login >/dev/null; then
    healthy=true
    break
  fi
  sleep 1
done

if [[ "$healthy" != true ]]; then
  echo "New staging release failed its health check; restoring ${previous_target}." >&2
  ln -s "$previous_target" "$temporary_link"
  mv -Tf "$temporary_link" "${APP_ROOT}/current"
  systemctl restart "$SERVICE"
  exit 70
fi

echo "Staging release ${release} is healthy."
