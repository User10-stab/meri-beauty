# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# bare "env" copies (the .env* rule above does not match a name without the dot)
/env
/env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local-only notes, not for the shared repo. Point-in-time audits and specs
# live in /docs so the repo root stays down to the docs you actually read
# while working: setup, testing, and the prod runbooks.
/docs
CLIENT_DECISION_FORM.md
MERGE_NOTES_*.md
REVIEW_REPORT.md
REVIEW_REQUIREMENTS.md
SECURITY_AND_LOGIC_REVIEW.md
google-form-generator.gs
google-form-generator-round2.gs
google-form-generator-round3.gs

# one-off Wix data exports and client briefs — real business data, not app
# code, and nothing in the codebase reads them.
catalog_products*.csv
inventory*.csv
*.docx

# other AI/dev assistant state
.zcode/

# Google Forms response exports (client survey answers, not app code)
Merri Beauty — Points de suivi*.csv
Merri Beauty — Derniers points*.csv
Mondial Relay — Informations*.csv

# local dev tool binary, not app code
mailpit.exe
.aider*

# local AI/dev assistant state
.claude/

# GitHub Actions SSH keys
github-actions
github-actions.pub

# Local scratch output (rendered PDFs/screenshots from debugging)
/tmp

# Deployment tarballs built locally for the OVH VPS — build output, and large
# enough (150 MB+) to bloat the repo permanently if ever committed.
/.codex-deploy/

# Playwright money-suite HTML report (regenerated on every run; the suite's
# own artefacts, not source). /test-results is already ignored above.
/playwright-report-money/
