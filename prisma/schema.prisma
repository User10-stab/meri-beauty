// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum UserRole {
  OWNER
  STAFF
  CUSTOMER
  ADMIN
}

enum StaffType {
  EMPLOYEE
  INDEPENDENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_PAID
}

enum PaymentType {
  ON_SITE
  ONLINE
  DEPOSIT
}

enum InvoiceSource {
  ORDER
  APPOINTMENT
  WORKSHOP
  FORMATION
}

enum ReturnStatus {
  REQUESTED // customer submitted it, awaiting staff review
  APPROVED // staff accepted it — waiting for the item to actually come back
  REJECTED
  COMPLETED // item received, stock restored, refund/credit note issued
}

enum TransactionMethod {
  CASH
  CARD
  ONLINE
}

enum TransactionType {
  DEPOSIT
  FINAL_PAYMENT
  REFUND
}

enum ContractType {
  PERCENTAGE
  FIXED_RENT
  HYBRID
}

// Language enum kept for backward compatibility — new code uses Staff.languages as String[]
enum Language {
  ARABIC
  FRENCH
  ENGLISH
  SPANISH
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_PENDING
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum RecipientStatus {
  SENT
  OPENED
  FAILED
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// BOUTIQUE ENUMS

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MovementType {
  SALE
  RESTOCK
  RETURN
  LOSS
  ADJUSTMENT
  SALON_USAGE // product taken from retail stock during a service
}

enum CommissionType {
  PERCENTAGE
  FIXED
  HYBRID
}

// COMMERCE ENUMS

enum CartStatus {
  ACTIVE
  CONVERTED // turned into an Order
  ABANDONED
}

enum FulfilmentMode {
  PICKUP_PREPAID // pay online, collect in salon
  PICKUP_ON_SITE // reserve online, pay at counter on pickup
  SHIPPING_PREPAID // pay online, bpost delivery
}

enum OrderStatus {
  PENDING_PAYMENT // prepaid modes — Stripe checkout started, not yet settled
  PENDING_PICKUP // pickup+pay-on-site — confirmed, stock reserved, awaiting the customer
  PAID // payment settled, not yet fulfilled
  PROCESSING // shipping mode — preparing the parcel
  READY_FOR_PICKUP // staff has set the order aside in the salon
  SHIPPED // handed to bpost, tracking code set
  COMPLETED // picked up, or shipped and closed out
  CANCELLED
  EXPIRED // pay-on-site pickup not collected within the deadline
}

enum WeekDay {
  MONDAY

  TUESDAY

  WEDNESDAY

  THURSDAY

  FRIDAY

  SATURDAY

  SUNDAY
}

enum ReservationConfirmationMode {
  AUTOMATIC
  MANUAL
}

// ─── WORKSHOP / EVENT ENUMS ────────────────────────────────────────────────────

enum WorkshopType {
  WORKSHOP
  EVENT
}

enum WorkshopStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum WorkshopReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum WaitingListStatus {
  WAITING
  NOTIFIED
  EXPIRED
  CONVERTED
  REMOVED
}

// ─── FORMATION ENUMS ────────────────────────────────────────────────────────

enum FormationType {
  PRIVATE
  PUBLIC
}

enum FormationStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum FormationReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ─── WORKSHOP / EVENT MODELS ───────────────────────────────────────────

model Activity {
  id                    String         @id @default(cuid())
  type                  WorkshopType
  title                 String
  description           String?
  cover                 String?
  price                 Decimal        @db.Decimal(10, 2)
  duration              Int
  language              String?
  capacity              Int
  animatorId            String?
  animator              Animator?      @relation(fields: [animatorId], references: [id])
  status                WorkshopStatus @default(DRAFT)
  allowMultipleSessions Boolean        @default(false)
  depositPercentage     Int            @default(50)
  createdById           String?
  createdBy             User?          @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  sessions WorkshopSession[]

  @@map("workshops")
}

model WorkshopSession {
  id                   String        @id @default(cuid())
  workshopId           String
  workshop             Activity      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  animatorId           String?
  animator             Animator?     @relation(fields: [animatorId], references: [id])
  startDate            DateTime
  endDate              DateTime?
  capacity             Int
  status               SessionStatus @default(SCHEDULED)
  registrationDeadline DateTime?
  lowSeatsNotifiedAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  reservations         WorkshopReservation[]
  waitingList          WaitingListEntry[]
  previousReservations WorkshopReservation[] @relation("ReservationPreviousSession")

  @@index([workshopId])
  @@map("workshop_sessions")
}

model WorkshopReservation {
  id                String                    @id @default(cuid())
  sessionId         String
  session           WorkshopSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User                      @relation(fields: [customerId], references: [id])
  payment           Payment?
  seatsCount        Int                       @default(1)
  status            WorkshopReservationStatus @default(PENDING_DEPOSIT)
  holdExpiresAt     DateTime?
  depositAmount     Decimal                   @default(0) @db.Decimal(10, 2)
  totalPrice        Decimal                   @db.Decimal(10, 2)
  balanceDue        Decimal                   @default(0) @db.Decimal(10, 2)
  previousSessionId String?
  previousSession   WorkshopSession?          @relation("ReservationPreviousSession", fields: [previousSessionId], references: [id])
  changeFeeAmount   Decimal                   @default(0) @db.Decimal(10, 2)
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?                     @relation("ReservationCancelledBy", fields: [cancelledByUserId], references: [id])
  participants      String?
  notes             String?
  reminderSentAt    DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([sessionId])
  @@index([customerId])
  @@map("workshop_reservations")
}

model WaitingListEntry {
  id                       String            @id @default(cuid())
  sessionId                String
  session                  WorkshopSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId               String
  customer                 User              @relation(fields: [customerId], references: [id])
  seatsRequested           Int               @default(1)
  position                 Int
  status                   WaitingListStatus @default(WAITING)
  notifiedAt               DateTime?
  expiresAt                DateTime?
  convertedToReservationId String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([sessionId, position])
  @@index([sessionId, status])
  @@map("waiting_list_entries")
}

model Animator {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  bio       String?
  avatar    String?
  website   String?
  instagram String?
  facebook  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities        Activity[]
  sessions          WorkshopSession[]
  formations        Formation[]
  formationSessions FormationSession[]

  @@map("animators")
}

// ─── FORMATION MODELS ───────────────────────────────────────────────────────
// Training courses. Structurally parallel to Activity/WorkshopSession/
// WorkshopReservation above, but deliberately kept as separate tables: none
// of the atelier-only features (48h cancellation cutoff, waiting list,
// low-seats banner/email, paid session/seat change) apply here, so this
// stays a plain CRUD + deposit/full-payment module instead of threading
// exclusions through the ateliers code.

model Formation {
  id                    String          @id @default(cuid())
  type                  FormationType
  title                 String
  description           String?
  cover                 String?
  price                 Decimal         @db.Decimal(10, 2)
  duration              Int
  language              String?
  capacity              Int // PRIVATE: always 1 (enforced in Zod); PUBLIC: admin-set, no ceiling
  animatorId            String?
  animator              Animator?       @relation(fields: [animatorId], references: [id])
  status                FormationStatus @default(DRAFT)
  allowMultipleSessions Boolean         @default(false)
  depositPercentage     Int             @default(30)
  createdById           String?
  createdBy             User?           @relation("FormationCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  sessions FormationSession[]

  @@map("formations")
}

model FormationSession {
  id                   String        @id @default(cuid())
  formationId          String
  formation            Formation     @relation(fields: [formationId], references: [id], onDelete: Cascade)
  animatorId           String?
  animator             Animator?     @relation(fields: [animatorId], references: [id])
  startDate            DateTime
  endDate              DateTime?
  capacity             Int
  status               SessionStatus @default(SCHEDULED)
  registrationDeadline DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  reservations FormationReservation[]

  @@index([formationId])
  @@map("formation_sessions")
}

model FormationReservation {
  id             String                     @id @default(cuid())
  sessionId      String
  session        FormationSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User                       @relation(fields: [customerId], references: [id])
  payment        Payment?
  seatsCount     Int                        @default(1) // always 1 for PRIVATE
  status         FormationReservationStatus @default(PENDING_DEPOSIT)
  holdExpiresAt  DateTime?
  depositAmount  Decimal                    @default(0) @db.Decimal(10, 2)
  totalPrice     Decimal                    @db.Decimal(10, 2)
  balanceDue     Decimal                    @default(0) @db.Decimal(10, 2)
  participants   String?
  notes          String?
  reminderSentAt DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([sessionId])
  @@index([customerId])
  @@map("formation_reservations")
}

model Salon {
  id          String  @id @default(cuid())
  name        String
  description String?
  logo        String?
  coverImage  String?

  phone     String
  email     String
  address   String?
  vatNumber String? // legal TVA/BCE number — printed on every issued invoice

  instagram String?
  facebook  String?
  tiktok    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gallery     SalonGallery[]
  workingDays SalonWorkingDay[]
  closures    SalonClosure[]
  newsletters Newsletter[]
}

model SalonWorkingDay {
  id          String  @id @default(cuid())
  day         WeekDay
  isOpen      Boolean @default(true)
  openingTime String
  closingTime String
  salonId     String
  salon       Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, day])
}

model SalonClosure {
  id          String    @id @default(cuid())
  title       String
  startDate   DateTime
  endDate     DateTime?
  isFullDay   Boolean   @default(true)
  openingTime String?
  closingTime String?
  salonId     String
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// USER
model User {
  id                   String    @id @default(cuid())
  fullName             String
  nickName             String?
  email                String    @unique
  password             String
  phone                String    @unique
  role                 UserRole
  avatar               String?
  emailVerified        Boolean   @default(false)
  isActive             Boolean   @default(true)
  lastLogin            DateTime?
  // Bumped whenever this user's password changes (reset or self-service) so
  // the JWT session callback can detect and invalidate stale sessions issued
  // before the change — see auth.js#jwt.
  sessionVersion       Int       @default(0)
  newsletterSubscribed Boolean   @default(false)
  vatNumber            String? // Client TVA number for B2B invoices
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  staff                 Staff?
  appointments          Appointment[]
  reviews               Review[]
  notifications         Notification[]
  newsletterRecipients  NewsletterRecipient[]
  createdStaffServices  StaffService[]         @relation("CreatedBy")
  rentalRequests        RentalRequest[]
  workshopReservations  WorkshopReservation[]
  waitingListEntries    WaitingListEntry[]
  createdActivities     Activity[]             @relation("ActivityCreatedBy")
  cancelledReservations WorkshopReservation[]  @relation("ReservationCancelledBy")
  formationReservations FormationReservation[]
  createdFormations     Formation[]            @relation("FormationCreatedBy")
  stockMovements        InventoryMovement[]    @relation("StockMovementBy")
  carts                 Cart[]
  orders                Order[]                @relation("OrderBuyer")
  pickedUpOrders        Order[]                @relation("OrderPickedUpBy")
  processedReturns      ReturnRequest[]        @relation("ReturnProcessedBy")
}

// CATEGORY — services only. Retail products use ProductCategory.
model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  services Service[]
}

// ─────────────────────────────────────────────────────────────────────────────
// BOUTIQUE — CATALOGUE
// ─────────────────────────────────────────────────────────────────────────────

// BRAND
// Root of the catalogue tree: Brand → ProductCategory → ProductSubcategory →
// Product. A category belongs to exactly one brand (client decision,
// 29 Jul 2026) — two brands each having their own "Bases" category are two
// separate ProductCategory rows, not a shared one.
model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logo        String?
  description String?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories ProductCategory[]

  @@index([slug])
  @@index([isActive, isDeleted])
}

// PRODUCT CATEGORY
// Brand-scoped — slug is unique per brand, not globally, since the same
// category name ("Bases", "Accessoires"...) commonly recurs across brands.
model ProductCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories ProductSubcategory[]

  @@unique([brandId, slug])
  @@index([brandId])
}

// PRODUCT SUBCATEGORY
model ProductSubcategory {
  id       String  @id @default(cuid())
  name     String
  slug     String
  position Int     @default(0)
  isActive Boolean @default(true)

  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// PRODUCT
// Descriptive only — every sellable unit, price and stock level lives on
// ProductVariant, so a product with one size still has exactly one variant.
//
// Brand is deliberately NOT stored directly on Product — it's derived via
// subcategory.category.brand. Storing it a second time here would let a
// product's brand disagree with its own category's brand; since the tree is
// now Brand → Category → Subcategory → Product, subcategoryId alone already
// determines the brand unambiguously.
model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // Nullable so a subcategory can actually be deleted once it has no active
  // products left — an archived (soft-deleted) product's row still exists
  // forever (see isDeleted below) and would otherwise block deletion forever
  // too. onDelete: SetNull only ever fires for those already-archived rows,
  // since deleteProductSubcategory() refuses to delete while any non-deleted
  // product still references it.
  subcategoryId String?
  subcategory   ProductSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  status ProductStatus @default(DRAFT)

  // Never hard-delete: OrderItem references variants of this product forever.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([slug])
  @@index([subcategoryId])
  @@index([status, isDeleted])
}

// PRODUCT VARIANT
// The sellable unit: "250 ml", "Teinte 03". Carries sku, barcode, prices and stock.
//
// profit and margin are intentionally absent — both are derivations of
// (price - costPrice). Stored, they go stale the moment either input changes
// and leave three fields that can contradict each other. Compute on read.
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name        String // "250 ml", "Teinte 03" — "Standard" for single-variant products
  sku         String  @unique
  barcode     String? @unique // EAN/UPC; null until an internal code is generated
  weightGrams Int     @default(0) // Weight in grams for shipping cost calculation

  price        Decimal  @db.Decimal(10, 2) // selling price, TVA included
  costPrice    Decimal  @db.Decimal(10, 2) // supplier cost — "prix initial"
  comparePrice Decimal? @db.Decimal(10, 2) // struck-through price — "prix barré"

  // Available to sell = stockQuantity - reservedQuantity.
  // Reservation is NOT an InventoryMovement: it does not change stock on hand,
  // and folding it in would break SUM(quantity) == stockQuantity.
  stockQuantity     Int @default(0)
  reservedQuantity  Int @default(0)
  lowStockThreshold Int @default(3)

  position Int     @default(0)
  isActive Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive, isDeleted])
}

// PRODUCT IMAGE
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  path      String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
}

// INVENTORY MOVEMENT
// Append-only ledger. quantity is signed, so SUM(quantity) reconciles to
// ProductVariant.stockQuantity. Written in the same transaction as the stock
// update, never after it.
model InventoryMovement {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  type     MovementType
  quantity Int // negative for SALE / LOSS / SALON_USAGE, positive for RESTOCK / RETURN

  previousStock Int
  newStock      Int

  reason String?

  createdById String?
  createdBy   User?   @relation("StockMovementBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOUTIQUE — COMMERCE (cart, checkout, orders)
// ─────────────────────────────────────────────────────────────────────────────

// CART
// Identified by a random `token` set in a cookie so a browsing session has a
// cart before the customer is known; `userId` is attached once they log in /
// check out. Never hard-delete CartItems on checkout — the cart is marked
// CONVERTED and left as history, the Order is the new source of truth.
model Cart {
  id String @id @default(cuid())

  token String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  CartItem[]
  orders Order[]

  @@index([userId])
}

// CART ITEM
model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ORDER
// `orderNumber` is a human-readable display number (gaps are fine — Belgian
// gapless-sequence law applies to invoices, not orders; a separate Invoice
// model will own that numbering). Shipping fields only apply to
// SHIPPING_PREPAID; pickup fields only apply to the two PICKUP_* modes —
// left nullable rather than split into subtype tables since an Order is
// always exactly one fulfilment mode for its whole lifetime.
model Order {
  id          String @id @default(cuid())
  orderNumber Int    @unique @default(autoincrement())

  userId String
  user   User   @relation("OrderBuyer", fields: [userId], references: [id])

  // The cart this order was checked out from — null for older orders created
  // before this field existed. Prepaid orders keep their source cart ACTIVE
  // until payment actually succeeds (see fulfillOrderPayment), specifically so
  // a customer who abandons the Stripe redirect still finds their cart intact
  // instead of it looking silently cleared.
  cartId String?
  cart   Cart?   @relation(fields: [cartId], references: [id])

  fulfilmentMode FulfilmentMode
  status         OrderStatus    @default(PENDING_PAYMENT)

  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  totalAmount  Decimal @db.Decimal(10, 2)

  // Shipping (SHIPPING_PREPAID)
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingPostalCode String?
  shippingCountry    String?   @default("BE")
  bpostTrackingCode  String?
  shippedAt          DateTime?

  // Pickup (PICKUP_PREPAID / PICKUP_ON_SITE)
  pickupCode        String?   @unique // QR payload scanned by staff at collection
  pickedUpAt        DateTime?
  pickedUpByStaffId String?
  pickedUpByStaff   User?     @relation("OrderPickedUpBy", fields: [pickedUpByStaffId], references: [id])

  // PENDING_PICKUP orders auto-cancel + restock if not collected by this date
  expiresAt    DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  payment        Payment?
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([status])
}

// ORDER ITEM
// Snapshots product/variant name, sku and unitPrice at time of purchase —
// the variant itself may be repriced or renamed later, but a placed order
// must keep showing what the customer actually bought and paid.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  productName String
  variantName String
  sku         String

  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  createdAt DateTime @default(now())

  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@index([variantId])
}

// RETURN REQUEST
// Belgian/EU 14-day withdrawal right. Customer-initiated (order lookup by
// number + email, no account/login required — see actions/boutique/returns.js)
// for any COMPLETED order still inside its withdrawal window. Supports
// partial returns: one order can have several ReturnRequests over time as
// long as the returned quantity per item never exceeds what was bought.
model ReturnRequest {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  status ReturnStatus @default(REQUESTED)
  reason String

  requestedAt DateTime @default(now())

  processedAt        DateTime?
  processedByStaffId String?
  processedByStaff   User?     @relation("ReturnProcessedBy", fields: [processedByStaffId], references: [id])
  staffNote          String?

  // Set only once COMPLETED with a refund — the credit note that
  // documents the money actually credited back for this return.
  creditNoteId String?     @unique
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id])

  items ReturnRequestItem[]

  @@index([orderId])
  @@index([status])
}

// RETURN REQUEST ITEM
model ReturnRequestItem {
  id String @id @default(cuid())

  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  quantity Int

  @@index([returnRequestId])
  @@index([orderItemId])
}

// SERVICE
model Service {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices StaffService[]
}

// STAFF
model Staff {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  type              StaffType
  languages         String[]
  bio               String?
  isActive          Boolean   @default(true)
  photo             String?
  hireDate          DateTime?
  yearsOfExperience Int
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  vatNumber         String?   @unique

  // Reservation Settings
  reservationConfirmationMode ReservationConfirmationMode @default(MANUAL)
  depositEnabled              Boolean                     @default(false)
  depositPercentage           Decimal                     @default(10.0) @db.Decimal(5, 2)

  // Account Setup
  setupCompleted Boolean @default(false)

  // Bank account details
  accountHolderName String?
  iban              String?
  bic               String?
  bankName          String?

  // Stripe Connect
  stripeAccountId      String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)

  // Calendar sync — a revocable random token gating the iCal subscription
  // feed (app/api/calendar-feed/[token]). Null until the staff member first
  // requests their feed URL. A DB field (not an HMAC of staffId) so it can
  // actually be rotated if a URL ever leaks, without touching a global secret.
  calendarToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices StaffService[]
  workingHours  WorkingHour[]
  timeOffs      TimeOff[]
  contracts     Contract[]
}

// StaffService
model StaffService {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  price    Decimal
  duration Int
  margin   Decimal?
  photo    String
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([staffId, serviceId])
}

// APPOINTMENT
model Appointment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  staffServiceId String
  staffService   StaffService @relation(fields: [staffServiceId], references: [id])

  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus
  notes     String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  payment       Payment?
  review        Review?
  notifications Notification[]
}

// PAYMENT
// Polymorphic: exactly one of appointmentId / orderId / workshopReservationId
// / formationReservationId is set, enforced by a raw-SQL CHECK constraint
// added after the migration (see prisma/migrations/*/migration.sql for
// "Payment_exactly_one_source") — Prisma has no schema-level XOR.
model Payment {
  id                     String                @id @default(cuid())
  appointmentId          String?               @unique
  appointment            Appointment?          @relation(fields: [appointmentId], references: [id])
  orderId                String?               @unique
  order                  Order?                @relation(fields: [orderId], references: [id])
  workshopReservationId  String?               @unique
  workshopReservation    WorkshopReservation?  @relation(fields: [workshopReservationId], references: [id])
  formationReservationId String?               @unique
  formationReservation   FormationReservation? @relation(fields: [formationReservationId], references: [id])
  depositAmount          Decimal               @default(0)
  totalAmount            Decimal
  paidAmount             Decimal
  remainingAmount        Decimal
  paymentType            PaymentType
  status                 PaymentStatus
  paidAt                 DateTime?
  isDeleted              Boolean               @default(false)
  deletedAt              DateTime?
  transactionReference   String?

  transactions Transaction[]
  invoice      Invoice?
}

// NUMBERING COUNTER
// Atomic per-key counter backing legally-gapless sequential numbering
// (invoices, credit notes — Belgian TVA law requires an unbroken sequence,
// not just "usually in order"). One row per series+year, e.g. "invoice-2026".
// Incremented via a single UPDATE...RETURNING inside the SAME transaction as
// the document it numbers (see lib/invoicing.js), so a rolled-back
// transaction never burns a number.
model NumberingCounter {
  key        String @id
  lastNumber Int    @default(0)
}

// INVOICE
// One per Payment, created the moment a sale is actually settled (Stripe
// payment confirmed, or cash/card collected in person) — never at checkout
// time, since an unpaid/abandoned order or appointment must never consume a
// number. Seller/customer/line data is a frozen snapshot taken at issue
// time (copied in, never joined live) because the invoice must keep
// reflecting what was true when issued even if the product, customer, or
// salon info changes afterwards.
model Invoice {
  id     String        @id @default(cuid())
  number String        @unique // "2026-000001" — year + gapless in-year sequence
  source InvoiceSource

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  issuedAt DateTime @default(now())

  sellerName      String
  sellerAddress   String?
  sellerVatNumber String?

  customerName      String
  customerEmail     String
  customerVatNumber String? // Client TVA number (copied from User.vatNumber at invoice time)
  customerAddress   String?

  subtotalExclVat Decimal @db.Decimal(10, 2)
  vatRate         Decimal @default(21) @db.Decimal(4, 2)
  vatAmount       Decimal @db.Decimal(10, 2)
  totalInclVat    Decimal @db.Decimal(10, 2)

  lines       InvoiceLine[]
  creditNotes CreditNote[]

  @@index([paymentId])
}

// INVOICE LINE
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
}

// CREDIT NOTE
// Issued alongside a refund whenever an already-invoiced order/appointment
// is cancelled — never edits or deletes the original Invoice, Belgian law
// requires the correction to be its own numbered document. Own gapless
// sequence, separate counter from Invoice's.
model CreditNote {
  id     String @id @default(cuid())
  number String @unique // "NC2026-000001"

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  reason       String?
  issuedAt     DateTime @default(now())
  totalInclVat Decimal  @db.Decimal(10, 2)

  returnRequest ReturnRequest?

  @@index([invoiceId])
}

// TRANSACTION
model Transaction {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])

  amount          Decimal
  method          TransactionMethod
  transactionType TransactionType
  paidAt          DateTime
  createdAt       DateTime          @default(now())
  isDeleted       Boolean           @default(false)
  deletedAt       DateTime?
}

// CONTRACT
model Contract {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  type                 ContractType
  commissionPercentage Float?
  fixedRent            Decimal?
  startDate            DateTime
  endDate              DateTime?
  status               ContractStatus
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

// WORKING HOUR
model WorkingHour {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  day       WeekDay
  startTime String
  endTime   String
  isClosed  Boolean @default(false)
}

// TIME OFF
model TimeOff {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  startDate DateTime
  endDate   DateTime
  reason    String?
}

// REVIEW
model Review {
  id String @id @default(cuid())

  userId        String
  appointmentId String @unique

  user        User        @relation(fields: [userId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NOTIFICATION
model Notification {
  id String @id @default(cuid())

  userId        String
  appointmentId String?

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  type    NotificationType
  title   String
  message String

  status    NotificationStatus
  sentAt    DateTime?
  createdAt DateTime           @default(now())
}

// NEWSLETTER
model Newsletter {
  id String @id @default(cuid())

  title       String
  subject     String
  content     String
  status      NewsletterStatus
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  recipients NewsletterRecipient[]
}

// NEWSLETTER RECIPIENT
model NewsletterRecipient {
  id String @id @default(cuid())

  newsletterId String
  userId       String

  newsletter Newsletter @relation(fields: [newsletterId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  status   RecipientStatus
  openedAt DateTime?

  @@unique([newsletterId, userId])
}

// RENTAL REQUEST
model RentalRequest {
  id             String              @id @default(cuid())
  userId         String?
  user           User?               @relation(fields: [userId], references: [id])
  rentalType     String
  startDate      DateTime
  endDate        DateTime?
  commissionType CommissionType
  status         RentalRequestStatus
  message        String?
  ownerResponse  String?
  specialty      String?
  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// SALON GALLERY
model SalonGallery {
  id String @id @default(cuid())

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])

  image     String
  createdAt DateTime @default(now())
}

// PASSWORD RESET TOKEN
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// EMAIL VERIFICATION TOKEN
model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}
