// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum UserRole {
  OWNER
  STAFF
  CUSTOMER
  ADMIN
}

enum StaffType {
  EMPLOYEE
  INDEPENDENT
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum AppointmentCancellationSource {
  CUSTOMER
  STAFF
  ADMIN
  STRIPE
  REFUND_RECONCILIATION
  SYSTEM
}

// A customer may ask the salon to make an exception to the normal
// non-refundable deposit policy. This is deliberately a request, never a
// cancellation: only an OWNER/ADMIN can approve it and trigger the refund.
enum AppointmentCancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Ateliers and formations are admin-cancel-only by policy (the deposit is
// non-refundable, exceptions are case-by-case). Kept as its own enum + table
// rather than widening AppointmentCancellationRequest: the appointment
// version is already live, and a polymorphic rewrite of a table holding real
// requests is not a migration worth risking for shared naming.
enum ReservationCancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_PAID
  PARTIALLY_REFUNDED
  FAILED
  // A refund was decided (cancellation/return approved) but the Stripe call
  // hasn't been confirmed successful yet — set right before attempting it,
  // so a crash/timeout mid-call still leaves a durably queryable row for
  // the retry job to pick up, not just whatever the synchronous try/catch
  // managed to report. See lib/payments/retry-failed-refunds.js.
  REFUND_PENDING
  // The Stripe refund call itself errored (network, card issuer, etc.) —
  // previously only surfaced via a best-effort staff email that could be
  // missed; now durably retryable via the same job.
  REFUND_FAILED
}

enum PaymentType {
  ON_SITE
  ONLINE
  DEPOSIT
}

enum InvoiceSource {
  ORDER
  APPOINTMENT
  WORKSHOP
  FORMATION
}

enum PromoCodeType {
  PERCENTAGE
  FIXED
}

enum ReturnStatus {
  REQUESTED // customer submitted it, awaiting staff review
  APPROVED // staff accepted it — waiting for the item to actually come back
  REJECTED
  COMPLETED // item received, stock restored, refund/credit note issued
}

// Distinguishes the 14-day withdrawal right (CHANGED_MIND — the only
// category actually bound by withdrawalWindow()) from claims governed by
// other legal bases entirely: the 2-year statutory guarantee (DEFECTIVE),
// the shop's own fulfilment error (WRONG_ITEM, DAMAGED_IN_TRANSIT), a
// carrier issue (NOT_RECEIVED), or a discretionary exception (GOODWILL).
// Conflating these behind one "délai dépassé" rejection is what
// bigbatch.txt P1 "Rétractation et produit défectueux sont confondus"
// flagged — see actions/boutique/returns.js.
enum ReturnReasonCategory {
  CHANGED_MIND
  DEFECTIVE
  WRONG_ITEM
  DAMAGED_IN_TRANSIT
  NOT_RECEIVED
  GOODWILL
}

enum TransactionMethod {
  CASH
  CARD
  ONLINE
}

enum TransactionType {
  DEPOSIT
  FINAL_PAYMENT
  REFUND
}

enum ContractType {
  PERCENTAGE
  FIXED_RENT
  HYBRID
}

// Language enum kept for backward compatibility — new code uses Staff.languages as String[]
enum Language {
  ARABIC
  FRENCH
  ENGLISH
  SPANISH
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_CANCELLATION_REQUEST
  RESERVATION_CANCELLATION_REQUEST
  APPOINTMENT_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_PENDING
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum RecipientStatus {
  SENT
  OPENED
  FAILED
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// BOUTIQUE ENUMS

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MovementType {
  SALE
  RESTOCK
  RETURN
  LOSS
  ADJUSTMENT
  SALON_USAGE // product taken from retail stock during a service
  // A returned item pulled aside for inspection/disposal instead of going
  // back into vendable stock — see ReturnItemCondition. stockQuantity is
  // deliberately left unchanged by this movement; it exists purely as the
  // audit trail of the item physically coming back.
  RETURN_QUARANTINE
}

// Physical condition staff record for each returned line item at
// completeReturnRequest time, before any restock decision is made — see
// actions/boutique/returns.js. Only SEALED_RESELLABLE ever increments
// ProductVariant.stockQuantity.
enum ReturnItemCondition {
  SEALED_RESELLABLE // unopened, resalable as-is
  OPENED_HYGIENE // hygiene-exempt product opened/unsealed — never resold
  DAMAGED // packaging or product damaged — quarantine for assessment
  DEFECTIVE // faulty product — quarantine for supplier return
  WRONG_ITEM // shop's shipping error — inspect before any restock
}

enum CommissionType {
  PERCENTAGE
  FIXED
  HYBRID
}

// COMMERCE ENUMS

enum CartStatus {
  ACTIVE
  CONVERTED // turned into an Order
  ABANDONED
}

enum FulfilmentMode {
  PICKUP_PREPAID // pay online, collect in salon
  PICKUP_ON_SITE // reserve online, pay at counter on pickup
  SHIPPING_PREPAID // pay online, bpost delivery
}

enum VatTreatment {
  DOMESTIC
  EU_DISTANCE_SALE
  EU_REVERSE_CHARGE
  EXPORT
}

enum InvoiceCustomerType {
  B2C
  B2B
}

enum OrderStatus {
  PENDING_PAYMENT // prepaid modes — Stripe checkout started, not yet settled
  PENDING_PICKUP // pickup+pay-on-site — confirmed, stock reserved, awaiting the customer
  PAID // payment settled, not yet fulfilled
  PROCESSING // shipping mode — preparing the parcel
  READY_FOR_PICKUP // staff has set the order aside in the salon
  SHIPPED // handed to bpost, tracking code set
  COMPLETED // picked up, or shipped and closed out
  CANCELLED
  EXPIRED // pay-on-site pickup not collected within the deadline
}

enum OrderSource {
  ONLINE
  POS
}

enum WeekDay {
  MONDAY

  TUESDAY

  WEDNESDAY

  THURSDAY

  FRIDAY

  SATURDAY

  SUNDAY
}

enum ReservationConfirmationMode {
  AUTOMATIC
  MANUAL
}

enum AllowedPaymentMethods {
  BOTH
  ONLINE_ONLY
  CASH_ONLY
}

// ─── WORKSHOP / EVENT ENUMS ────────────────────────────────────────────────────

enum WorkshopType {
  WORKSHOP
  EVENT
}

enum WorkshopStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum WaitingListStatus {
  WAITING
  NOTIFIED
  EXPIRED
  CONVERTED
  REMOVED
}

// ─── FORMATION ENUMS ────────────────────────────────────────────────────────

enum FormationType {
  PRIVATE
  PUBLIC
}

enum FormationStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum FormationReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ─── WORKSHOP / EVENT MODELS ───────────────────────────────────────────

model Activity {
  id                    String         @id @default(cuid())
  type                  WorkshopType
  title                 String
  description           String?
  cover                 String?
  // Catalogue price TTC (Belgian 21% VAT already included).
  price                 Decimal        @db.Decimal(10, 2)
  duration              Int
  language              String?
  capacity              Int
  animatorId            String?
  animator              Animator?      @relation(fields: [animatorId], references: [id])
  status                WorkshopStatus @default(DRAFT)
  allowMultipleSessions Boolean        @default(false)
  depositPercentage     Int            @default(50)
  createdById           String?
  createdBy             User?          @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  sessions WorkshopSession[]

  @@map("workshops")
}

model WorkshopSession {
  id                   String        @id @default(cuid())
  workshopId           String
  workshop             Activity      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  animatorId           String?
  animator             Animator?     @relation(fields: [animatorId], references: [id])
  startDate            DateTime
  endDate              DateTime?
  capacity             Int
  status               SessionStatus @default(SCHEDULED)
  registrationDeadline DateTime?
  lowSeatsNotifiedAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  reservations         WorkshopReservation[]
  waitingList          WaitingListEntry[]
  previousReservations WorkshopReservation[] @relation("ReservationPreviousSession")

  @@index([workshopId])
  @@map("workshop_sessions")
}

model WorkshopReservation {
  id                String                    @id @default(cuid())
  sessionId         String
  session           WorkshopSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User                      @relation(fields: [customerId], references: [id])
  payment           Payment?
  seatsCount        Int                       @default(1)
  status            WorkshopReservationStatus @default(PENDING_DEPOSIT)
  holdExpiresAt     DateTime?
  depositAmount     Decimal                   @default(0) @db.Decimal(10, 2)
  totalPrice        Decimal                   @db.Decimal(10, 2)
  balanceDue        Decimal                   @default(0) @db.Decimal(10, 2)
  // `totalPrice` above is already the post-discount figure; these two are
  // kept only so the eventual Payment row (created later, once Stripe
  // confirms) can copy which code was used and how much it took off.
  promoCodeId       String?
  promoCode         PromoCode?                @relation(fields: [promoCodeId], references: [id])
  discountAmount    Decimal                   @default(0) @db.Decimal(10, 2)
  previousSessionId String?
  previousSession   WorkshopSession?          @relation("ReservationPreviousSession", fields: [previousSessionId], references: [id])
  changeFeeAmount   Decimal                   @default(0) @db.Decimal(10, 2)
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?                     @relation("ReservationCancelledBy", fields: [cancelledByUserId], references: [id])
  participants      String?
  notes             String?
  reminderSentAt    DateTime?

  // Check-in ticket. Only issued once the reservation is CONFIRMED — i.e.
  // once money has actually moved — so a scan is proof of payment, not proof
  // of booking. Prefixed by domain ("A-") so one scanner can route a code to
  // the right lookup instead of answering "introuvable" when an atelier code
  // is scanned at the boutique till. See lib/activities/check-in-code.js.
  checkInCode    String?   @unique
  // Partial check-in: a 4-seat reservation whose holders arrive separately
  // must not be burned by the first scan.
  checkedInSeats Int       @default(0)
  checkedInAt    DateTime?
  checkedInById  String?
  checkedInBy    User?     @relation("WorkshopReservationCheckedInBy", fields: [checkedInById], references: [id])

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  cancellationRequest ReservationCancellationRequest?

  @@index([sessionId])
  @@index([customerId])
  @@map("workshop_reservations")
}

// Polymorphic: exactly one of sessionId (atelier) / formationSessionId
// (formation) is set — same pattern as Payment's exactly-one-source CHECK,
// see WaitingListEntry_exactly_one_session in the formation migration.
model WaitingListEntry {
  id                       String            @id @default(cuid())
  sessionId                String?
  session                  WorkshopSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  formationSessionId       String?
  formationSession         FormationSession? @relation(fields: [formationSessionId], references: [id], onDelete: Cascade)
  customerId               String
  customer                 User              @relation(fields: [customerId], references: [id])
  seatsRequested           Int               @default(1)
  position                 Int
  status                   WaitingListStatus @default(WAITING)
  notifiedAt               DateTime?
  expiresAt                DateTime?
  convertedToReservationId String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([sessionId, position])
  @@index([sessionId, status])
  @@index([formationSessionId, position])
  @@index([formationSessionId, status])
  @@map("waiting_list_entries")
}

model Animator {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  bio       String?
  avatar    String?
  website   String?
  instagram String?
  facebook  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities        Activity[]
  sessions          WorkshopSession[]
  formations        Formation[]
  formationSessions FormationSession[]

  @@map("animators")
}

enum WorkshopReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ─── FORMATION MODELS ───────────────────────────────────────────────────────
// Training courses. Structurally parallel to Activity/WorkshopSession/
// WorkshopReservation above, but deliberately kept as separate tables: none
// of the atelier-only features (48h cancellation cutoff, waiting list,
// low-seats banner/email, paid session/seat change) apply here, so this
// stays a plain CRUD + deposit/full-payment module instead of threading
// exclusions through the ateliers code.

model Formation {
  id                    String          @id @default(cuid())
  type                  FormationType
  title                 String
  description           String?
  cover                 String?
  // Catalogue price TTC (Belgian 21% VAT already included).
  price                 Decimal         @db.Decimal(10, 2)
  duration              Int
  language              String?
  capacity              Int // PRIVATE: always 1 (enforced in Zod); PUBLIC: admin-set, no ceiling
  animatorId            String?
  animator              Animator?       @relation(fields: [animatorId], references: [id])
  status                FormationStatus @default(DRAFT)
  allowMultipleSessions Boolean         @default(false)
  depositPercentage     Int             @default(50)
  createdById           String?
  createdBy             User?           @relation("FormationCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  sessions FormationSession[]

  @@map("formations")
}

model FormationSession {
  id                   String        @id @default(cuid())
  formationId          String
  formation            Formation     @relation(fields: [formationId], references: [id], onDelete: Cascade)
  animatorId           String?
  animator             Animator?     @relation(fields: [animatorId], references: [id])
  startDate            DateTime
  endDate              DateTime?
  capacity             Int
  status               SessionStatus @default(SCHEDULED)
  registrationDeadline DateTime?
  lowSeatsNotifiedAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  reservations FormationReservation[]
  waitingList  WaitingListEntry[]

  @@index([formationId])
  @@map("formation_sessions")
}

model FormationReservation {
  id                String                     @id @default(cuid())
  sessionId         String
  session           FormationSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User                       @relation(fields: [customerId], references: [id])
  payment           Payment?
  seatsCount        Int                        @default(1) // always 1 for PRIVATE
  status            FormationReservationStatus @default(PENDING_DEPOSIT)
  holdExpiresAt     DateTime?
  depositAmount     Decimal                    @default(0) @db.Decimal(10, 2)
  totalPrice        Decimal                    @db.Decimal(10, 2)
  balanceDue        Decimal                    @default(0) @db.Decimal(10, 2)
  // `totalPrice` above is already the post-discount figure; these two are
  // kept only so the eventual Payment row (created later, once Stripe
  // confirms) can copy which code was used and how much it took off.
  promoCodeId       String?
  promoCode         PromoCode?                 @relation(fields: [promoCodeId], references: [id])
  discountAmount    Decimal                    @default(0) @db.Decimal(10, 2)
  participants      String?
  notes             String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?                      @relation("FormationReservationCancelledBy", fields: [cancelledByUserId], references: [id])
  reminderSentAt    DateTime?

  // Same check-in ticket as WorkshopReservation, prefixed "F-".
  checkInCode    String?   @unique
  checkedInSeats Int       @default(0)
  checkedInAt    DateTime?
  checkedInById  String?
  checkedInBy    User?     @relation("FormationReservationCheckedInBy", fields: [checkedInById], references: [id])

  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  cancellationRequest ReservationCancellationRequest?

  @@index([sessionId])
  @@index([customerId])
  @@map("formation_reservations")
}

// SALON
model Salon {
  // The application has exactly one salon. The database migration also adds
  // a CHECK constraint so a caller cannot bypass this invariant by supplying
  // another id explicitly.
  id          String  @id @default("main-salon")
  name        String
  description String?
  logo        String?
  coverImage  String?

  phone     String
  email     String
  address   String? // freeform, shown on the public site (footer/contact) — not used for invoices
  vatNumber String? // legal TVA/BCE number — printed on every issued invoice
  rib       String? // bank account number / RIB
  billitApiKey String? // Billit API Key (keybellit)

  // Structured legal identity, required before any invoice can be issued
  // (see lib/invoicing.js#issueInvoice's seller-data gate) — kept separate
  // from the freeform `address` above since Peppol/UBL export (Phase B)
  // needs machine-parseable fields, not a single display string.
  legalName             String?
  companyRegistrationNo String? // BCE/KBO number — same digits as the VAT number for BE since 2017
  addressLine1          String?
  addressLine2          String?
  postalCode            String?
  city                  String?
  countryCode           String? @default("BE")

  instagram String?
  facebook  String?
  tiktok    String?

  // Dedup marker for notifyUnsettledAppointments (lib/appointments/) — an
  // atomic claim against this keeps the digest genuinely daily regardless
  // of how often the job runner ticks (every 5min in-process, plus whatever
  // external HTTP cron cadence is configured).
  unsettledAppointmentsDigestSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gallery     SalonGallery[]
  workingDays SalonWorkingDay[]
  closures    SalonClosure[]
  newsletters Newsletter[]
}

model SalonWorkingDay {
  id          String  @id @default(cuid())
  day         WeekDay
  isOpen      Boolean @default(true)
  openingTime String
  closingTime String
  salonId     String
  salon       Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, day])
}

model SalonClosure {
  id          String    @id @default(cuid())
  title       String
  startDate   DateTime
  endDate     DateTime?
  isFullDay   Boolean   @default(true)
  openingTime String?
  closingTime String?
  salonId     String
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// USER
model User {
  id                       String    @id @default(cuid())
  fullName                 String
  nickName                 String?
  email                    String    
  password                 String
  // A counter sale needs a receipt email, but a phone number is optional.
  // Online checkout and booking forms still require it at their own
  // validation boundary.
  phone                    String?  
  role                     UserRole
  avatar                   String?
  emailVerified            Boolean   @default(false)
  isActive                 Boolean   @default(true)
  lastLogin                DateTime?
  // Bumped whenever this user's password changes (reset or self-service) so
  // the JWT session callback can detect and invalidate stale sessions issued
  // before the change — see auth.js#jwt.
  sessionVersion           Int       @default(0)
  newsletterSubscribed     Boolean   @default(false)
  // Demonstrable, timestamped marketing consent — GDPR/ePrivacy requires
  // being able to show when/how/under-what-policy-version someone opted
  // in, not just the current boolean. Only ever set together (see
  // lib/newsletter-consent.js#buildNewsletterConsentUpdate) whenever
  // newsletterSubscribed transitions to true; left untouched on
  // unsubscribe so the original consent record stays intact as history.
  newsletterConsentedAt    DateTime?
  newsletterConsentSource  String? // e.g. "registration", "boutique_checkout", "appointment_booking", "account_settings"
  newsletterConsentVersion String? // which marketing-consent copy version was shown at opt-in time
  isCompany                Boolean   @default(false) // account type chosen at registration — "particulier" vs "entreprise"
  vatNumber                String? // Client TVA number for B2B invoices — required at registration when isCompany is true, VIES-verified (see lib/vat-validation.js)
  vatValidatedAt           DateTime?
  vatValidationName        String?
  vatValidationAddress     String?
  // Billing address — mandatory at registration (both particulier and
  // entreprise: a proper invoice needs the customer's address regardless of
  // account type, not just a VAT number for companies). Nullable at the DB
  // level only because accounts created before this field existed have no
  // value here — see lib/format-address.js#formatUserAddress and the
  // self-service edit in actions/customer/settings.js#updateMyAddress for
  // how existing accounts backfill it.
  addressLine1             String?
  addressLine2             String?
  addressCity              String?
  addressPostalCode        String?
  addressCountry           String?   @default("BE")
  // Same demonstrable-consent shape as the newsletter fields above — a
  // required checkbox at signup isn't enough on its own; GDPR/e-commerce
  // rules expect a record of WHEN a specific person agreed to WHICH version
  // of the CGV/CGU, not just a boolean. See lib/terms-consent.js.
  termsAcceptedAt          DateTime?
  termsAcceptedVersion     String?
  isDeleted                Boolean   @default(false)
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  staff                          Staff?
  appointments                   Appointment[]
  reviews                        Review[]
  notifications                  Notification[]
  newsletterRecipients           NewsletterRecipient[]
  createdStaffServices           StaffService[]         @relation("CreatedBy")
  rentalRequests                 RentalRequest[]
  workshopReservations           WorkshopReservation[]
  waitingListEntries             WaitingListEntry[]
  createdActivities              Activity[]             @relation("ActivityCreatedBy")
  cancelledReservations          WorkshopReservation[]  @relation("ReservationCancelledBy")
  formationReservations          FormationReservation[]
  cancelledFormationReservations FormationReservation[] @relation("FormationReservationCancelledBy")
  checkedInWorkshopReservations  WorkshopReservation[]  @relation("WorkshopReservationCheckedInBy")
  checkedInFormationReservations FormationReservation[] @relation("FormationReservationCheckedInBy")
  checkedInAppointments          Appointment[]          @relation("AppointmentCheckedInBy")
  cancelledAppointments          Appointment[]          @relation("AppointmentCancelledBy")
  createdFormations              Formation[]            @relation("FormationCreatedBy")
  stockMovements                 InventoryMovement[]    @relation("StockMovementBy")
  carts                          Cart[]
  orders                         Order[]                @relation("OrderBuyer")
  pickedUpOrders                 Order[]                @relation("OrderPickedUpBy")
  createdPointOfSaleOrders       Order[]                @relation("OrderCreatedByStaff")
  processedReturns               ReturnRequest[]        @relation("ReturnProcessedBy")
  auditLogs                      AuditLog[]             @relation("AuditActor")
  assignedDisputes               StripeDispute[]        @relation("DisputeAssignee")
  billingProfile                 BillingProfile?
  openedCashSessions             CashSession[]          @relation("CashSessionOpenedBy")
  closedCashSessions             CashSession[]          @relation("CashSessionClosedBy")
  submittedCancellationRequests  AppointmentCancellationRequest[] @relation("CancellationRequestSubmittedBy")
  reviewedCancellationRequests   AppointmentCancellationRequest[] @relation("CancellationRequestReviewedBy")
  submittedReservationCancellationRequests ReservationCancellationRequest[] @relation("ReservationCancellationRequestedBy")
  reviewedReservationCancellationRequests  ReservationCancellationRequest[] @relation("ReservationCancellationReviewedBy")

  @@index([role])
  @@index([isActive, isDeleted])
}

// Company legal identity for B2B invoicing — separate from the billing
// address on User (addressLine1 etc. above), which every account already
// has regardless of isCompany. Only meaningful when User.isCompany is true;
// its presence (companyLegalName set) is what makes an invoice B2B instead
// of B2C — see lib/invoicing.js#issueInvoice.
model BillingProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyLegalName       String
  companyRegistrationNo  String? // BCE/KBO or equivalent, if distinct from the VAT number
  companyLegalForm       String? // e.g. "SRL", "SA", "indépendant"
  billingContactName     String?
  purchaseOrderReference String? // the PO/order reference this customer wants printed on every invoice
  peppolParticipantId    String? // reserved for Phase B — not used until live Peppol delivery exists

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable operational trail. Target records are intentionally represented
// by type + id rather than foreign keys so an audit entry survives soft or
// hard deletion of its target.
model AuditLog {
  id String @id @default(cuid())

  actorId   String?
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole UserRole?

  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// Shared fixed-window counters for abuse-sensitive public operations. Unlike
// the in-memory limiter, these counters apply across every production instance.
model ApiRateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

// CATEGORY — services only. Retail products use ProductCategory.
model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  services Service[]
}

// ─────────────────────────────────────────────────────────────────────────────
// BOUTIQUE — CATALOGUE
// ─────────────────────────────────────────────────────────────────────────────

// BRAND
// Root of the catalogue tree: Brand → ProductCategory → ProductSubcategory →
// Product. A category belongs to exactly one brand (client decision,
// 29 Jul 2026) — two brands each having their own "Bases" category are two
// separate ProductCategory rows, not a shared one.
model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logo        String?
  description String?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories ProductCategory[]

  @@index([slug])
  @@index([isActive, isDeleted])
}

// PRODUCT CATEGORY
// Brand-scoped — slug is unique per brand, not globally, since the same
// category name ("Bases", "Accessoires"...) commonly recurs across brands.
model ProductCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories ProductSubcategory[]

  @@unique([brandId, slug])
  @@index([brandId])
}

// PRODUCT SUBCATEGORY
model ProductSubcategory {
  id       String  @id @default(cuid())
  name     String
  slug     String
  position Int     @default(0)
  isActive Boolean @default(true)

  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// PRODUCT
// Descriptive only — every sellable unit, price and stock level lives on
// ProductVariant, so a product with one size still has exactly one variant.
//
// Brand is deliberately NOT stored directly on Product — it's derived via
// subcategory.category.brand. Storing it a second time here would let a
// product's brand disagree with its own category's brand; since the tree is
// now Brand → Category → Subcategory → Product, subcategoryId alone already
// determines the brand unambiguously.
model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // Nullable so a subcategory can actually be deleted once it has no active
  // products left — an archived (soft-deleted) product's row still exists
  // forever (see isDeleted below) and would otherwise block deletion forever
  // too. onDelete: SetNull only ever fires for those already-archived rows,
  // since deleteProductSubcategory() refuses to delete while any non-deleted
  // product still references it.
  subcategoryId String?
  subcategory   ProductSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  status ProductStatus @default(DRAFT)

  // Wix export's stable per-product "handle" — set when a product is
  // brought in via the Wix importer. Lets a later re-import (e.g. after
  // Marie fills in more barcodes on Wix, since Wix's own barcode field is
  // unreliable/incomplete on export) recognize the same product and
  // backfill its barcode instead of creating a duplicate. Null for any
  // product never imported from Wix.
  wixHandle String? @unique

  // Never hard-delete: OrderItem references variants of this product forever.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([slug])
  @@index([subcategoryId])
  @@index([status, isDeleted])
}

// PRODUCT VARIANT
// The sellable unit: "250 ml", "Teinte 03". Carries sku, barcode, prices and stock.
//
// profit and margin are intentionally absent — both derive from the HT base of
// price (stored TTC) minus costPrice (stored HT). Stored, they go stale the
// moment either input changes and leave contradictory fields. Compute on read.
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name        String // "250 ml", "Teinte 03" — "Standard" for single-variant products
  sku         String  @unique
  barcode     String? @unique // EAN/UPC; null until an internal code is generated
  weightGrams Int     @default(0) // Weight in grams for shipping cost calculation

  // Customer-facing catalogue price, stored TTC: Belgian 21% VAT is already
  // included and must never be added again at checkout.
  price        Decimal  @db.Decimal(10, 2)
  costPrice    Decimal  @db.Decimal(10, 2) // supplier cost — "prix initial"
  // Struck-through price — "prix barré". TTC, like price above.
  comparePrice Decimal? @db.Decimal(10, 2)

  // Available to sell = stockQuantity - reservedQuantity.
  // Reservation is NOT an InventoryMovement: it does not change stock on hand,
  // and folding it in would break SUM(quantity) == stockQuantity.
  stockQuantity     Int @default(0)
  reservedQuantity  Int @default(0)
  lowStockThreshold Int @default(3)

  position Int     @default(0)
  isActive Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive, isDeleted])
}

// PRODUCT IMAGE
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  path      String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
}

// INVENTORY MOVEMENT
// Append-only ledger. quantity is signed, so SUM(quantity) reconciles to
// ProductVariant.stockQuantity. Written in the same transaction as the stock
// update, never after it.
model InventoryMovement {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  type     MovementType
  quantity Int // negative for SALE / LOSS / SALON_USAGE, positive for RESTOCK / RETURN

  previousStock Int
  newStock      Int

  reason String?

  createdById String?
  createdBy   User?   @relation("StockMovementBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOUTIQUE — COMMERCE (cart, checkout, orders)
// ─────────────────────────────────────────────────────────────────────────────

// CART
// Identified by a random `token` set in a cookie so a browsing session has a
// cart before the customer is known; `userId` is attached once they log in /
// check out. Never hard-delete CartItems on checkout — the cart is marked
// CONVERTED and left as history, the Order is the new source of truth.
model Cart {
  id String @id @default(cuid())

  token String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  CartItem[]
  orders Order[]

  @@index([userId])
}

// CART ITEM
model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ORDER
// `orderNumber` is a human-readable display number (gaps are fine — Belgian
// gapless-sequence law applies to invoices, not orders; a separate Invoice
// model will own that numbering). Shipping fields only apply to
// SHIPPING_PREPAID; pickup fields only apply to the two PICKUP_* modes —
// left nullable rather than split into subtype tables since an Order is
// always exactly one fulfilment mode for its whole lifetime.
model Order {
  id          String @id @default(cuid())
  orderNumber Int    @unique @default(autoincrement())

  // Null for an anonymous POS "client de passage" sale — no account is
  // created for a walk-in counter sale, see completePointOfSaleSale's
  // isWalkIn branch. Every other order source always sets this.
  userId String?
  user   User?   @relation("OrderBuyer", fields: [userId], references: [id])

  // The cart this order was checked out from — null for older orders created
  // before this field existed. Prepaid orders keep their source cart ACTIVE
  // until payment actually succeeds (see fulfillOrderPayment), specifically so
  // a customer who abandons the Stripe redirect still finds their cart intact
  // instead of it looking silently cleared.
  cartId String?
  cart   Cart?   @relation(fields: [cartId], references: [id])

  fulfilmentMode FulfilmentMode
  status         OrderStatus    @default(PENDING_PAYMENT)
  source         OrderSource    @default(ONLINE)

  // Counter-sale attribution and idempotency. The attempt key is generated
  // by the POS client and reused across retries, so double-clicks/network
  // retries cannot create a second order or Stripe Checkout Session.
  createdByStaffId String?
  createdByStaff   User?   @relation("OrderCreatedByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  posAttemptKey    String? @unique

  // Set the moment a Checkout Session is created for this order (before
  // Stripe confirms anything) — lets createOrderFromCart check with Stripe
  // directly whether an existing PENDING_PAYMENT order on the same cart was
  // actually already paid before assuming it's abandoned and cancelling it.
  // Without this, a webhook-delivery race could see a genuinely-paid order
  // get silently cancelled by a retry click, swallowing the payment.
  stripeCheckoutSessionId String? @unique

  subtotal          Decimal      @db.Decimal(10, 2)
  shippingCost      Decimal      @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal      @db.Decimal(10, 2)
  taxCountryCode    String       @default("BE")
  vatTreatment      VatTreatment @default(DOMESTIC)
  vatRate           Decimal      @default(21) @db.Decimal(4, 2)
  totalExclVat      Decimal?     @db.Decimal(10, 2)
  totalVat          Decimal?     @db.Decimal(10, 2)
  customerVatNumber String?
  taxNote           String?

  // `totalAmount` above is already the post-discount figure; these two are
  // kept only so the eventual Payment row (created later, once Stripe
  // confirms or the on-site pickup is completed) can copy which code was
  // used and how much it took off.
  promoCodeId    String?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  discountAmount Decimal    @default(0) @db.Decimal(10, 2)

  // Shipping (SHIPPING_PREPAID) — legacy bpost home-delivery fields, kept
  // nullable/unused so historical bpost orders keep their data rather than
  // being dropped when the carrier switched to Mondial Relay pickup points.
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingPostalCode String?
  shippingCountry    String?   @default("BE")
  bpostTrackingCode  String?
  shippedAt          DateTime?

  // Set when staff closes a SHIPPING_PREPAID order and confirms — from the
  // Mondial Relay tracking portal, since there is no delivery/collection
  // webhook integrated yet — the date the customer actually collected the
  // parcel from the relay point. This, not shippedAt, is the legal start of
  // the 14-day withdrawal window (SPF Économie: le lendemain de la prise de
  // possession réelle du bien). See withdrawalWindow() in
  // actions/boutique/returns.js.
  collectedAt DateTime?

  // Mondial Relay pickup point (current carrier). pickupPointId is null for
  // orders placed through the manual fallback form (no widget credentials
  // configured yet) — name/address/postalCode/city are always required either way.
  shippingCarrier       String? @default("MONDIAL_RELAY")
  pickupPointId         String?
  pickupPointName       String?
  pickupPointAddress    String?
  pickupPointPostalCode String?
  pickupPointCity       String?
  trackingCode          String?

  // Pickup (PICKUP_PREPAID / PICKUP_ON_SITE)
  pickupCode        String?   @unique // QR payload scanned by staff at collection
  pickedUpAt        DateTime?
  pickedUpByStaffId String?
  pickedUpByStaff   User?     @relation("OrderPickedUpBy", fields: [pickedUpByStaffId], references: [id])

  // PENDING_PICKUP orders auto-cancel + restock if not collected by this date
  expiresAt    DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  notes String?

  // POS walk-in ("client de passage") ticket e-mail — set the moment the
  // cashier submits an address, before knowing whether the send actually
  // succeeds. posTicketEmailSentAt only gets set on a confirmed Resend
  // success, so a non-null posTicketEmailTo with a null posTicketEmailSentAt
  // means "was requested, but the send failed" — the exact distinction a
  // support conversation needs and neither the cashier's toast nor console
  // logs are around to answer after the fact. Always null for a named
  // customer sale — their invoice already goes out over a different path.
  posTicketEmailTo     String?
  posTicketEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  payment        Payment?
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([fulfilmentMode])
  @@index([source, status, createdAt])
  @@index([createdByStaffId, createdAt])
}

// ORDER ITEM
// Snapshots product/variant name, sku and unitPrice at time of purchase —
// the variant itself may be repriced or renamed later, but a placed order
// must keep showing what the customer actually bought and paid.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Null for a POS ad-hoc service line — no ProductVariant backs it (see
  // completePointOfSaleSale's SERVICE branch). productName carries the
  // free-text description in that case.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  productName String
  variantName String?
  sku         String?

  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  createdAt DateTime @default(now())

  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@index([variantId])
}

// RETURN REQUEST
// Belgian/EU 14-day withdrawal right. Customer-initiated (order lookup by
// number + email, no account/login required — see actions/boutique/returns.js)
// for any COMPLETED order still inside its withdrawal window. Supports
// partial returns: one order can have several ReturnRequests over time as
// long as the returned quantity per item never exceeds what was bought.
model ReturnRequest {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  status         ReturnStatus         @default(REQUESTED)
  reasonCategory ReturnReasonCategory @default(CHANGED_MIND)
  reason         String

  requestedAt DateTime @default(now())

  processedAt        DateTime?
  processedByStaffId String?
  processedByStaff   User?     @relation("ReturnProcessedBy", fields: [processedByStaffId], references: [id])
  staffNote          String?

  // Set only once COMPLETED with a refund — the credit note that
  // documents the money actually credited back for this return.
  creditNoteId String?     @unique
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id])

  items ReturnRequestItem[]

  @@index([orderId])
  @@index([status])
}

// RETURN REQUEST ITEM
model ReturnRequestItem {
  id String @id @default(cuid())

  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  quantity Int

  // Set by staff at completeReturnRequest time (null until then — a
  // REQUESTED/APPROVED return hasn't been physically inspected yet).
  // Gates whether this item's quantity is restocked as vendable.
  condition ReturnItemCondition?

  @@index([returnRequestId])
  @@index([orderItemId])
}

// SERVICE
model Service {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices StaffService[]
}

// STAFF
model Staff {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  type              StaffType
  languages         String[]
  bio               String?
  isActive          Boolean   @default(true)
  photo             String?
  hireDate          DateTime?
  yearsOfExperience Int
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  vatNumber         String?   
  // Dashboard modules explicitly granted by an OWNER/ADMIN. Kept as stable
  // string capability keys so new permissions can be added without a DB enum migration.
  dashboardPermissions String[] @default(["APPOINTMENTS", "SERVICES", "CUSTOMERS", "FORMATIONS", "FORMATION_RESERVATIONS", "WORKSHOP_RESERVATIONS", "NEWSLETTER"])
  // Reservation Settings
  reservationConfirmationMode ReservationConfirmationMode @default(MANUAL)
  depositEnabled              Boolean                     @default(false)
  depositPercentage           Decimal                     @default(10.0) @db.Decimal(5, 2)
  allowedPaymentMethods       AllowedPaymentMethods       @default(BOTH)
  // % of the deposit withheld when rejectAppointment processes a late
  // cancellation (inside the 48h window) on a deposit-type payment. Default
  // 100 — the deposit is kept in full, matching what customers are told
  // (MyAppointmentsPageClient.jsx / MyReservationsClient.jsx: "L'acompte
  // reste acquis... sauf annulation exceptionnelle approuvée par
  // l'administration") — the only way back to a full refund is an admin
  // approving a cancellation-exception request, which passes
  // waiveDepositForfeit: true and skips this withholding entirely. Mirrors
  // the ateliers/formations policy (deposit non-refundable by default,
  // refundable only via the same admin-exception path).
  depositForfeitPercentage    Decimal                     @default(100) @db.Decimal(5, 2)

  // Account Setup
  setupCompleted Boolean @default(false)

  // Bank account details
  accountHolderName String?
  iban              String?
  bic               String?
  bankName          String?

  // Stripe Connect
  stripeAccountId      String? @unique
  stripeAccountType    String?
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)

  // Calendar sync — a revocable random token gating the iCal subscription
  // feed (app/api/calendar-feed/[token]). Null until the staff member first
  // requests their feed URL. A DB field (not an HMAC of staffId) so it can
  // actually be rotated if a URL ever leaks, without touching a global secret.
  calendarToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices StaffService[]
  workingHours  WorkingHour[]
  timeOffs      TimeOff[]
  contracts     Contract[]
  appointments  Appointment[]
  newsletters   Newsletter[]
}

// StaffService
model StaffService {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  price    Decimal
  duration Int
  margin   Decimal?
  photo    String
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([staffId, serviceId])
}

// APPOINTMENT
model Appointment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  staffServiceId String
  staffService   StaffService @relation(fields: [staffServiceId], references: [id])

  // Denormalized copy of staffService.staffId, set at creation time. Exists
  // so the DB-level no-overlap exclusion constraint can key on the actual
  // staff member instead of staffServiceId — a staff member offering
  // multiple services would otherwise not be protected by the constraint
  // against being double-booked across two different services at once.
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  date               DateTime
  startTime          DateTime
  endTime            DateTime
  status             AppointmentStatus
  notes              String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?                          @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancellationReason String?
  cancellationSource AppointmentCancellationSource?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  payment       Payment?
  review        Review?
  notifications Notification[]
  cancellationRequests AppointmentCancellationRequest[]

  // Dedup markers for the reminder cron (mirrors reservations'
  // reminderSentAt), one per window since appointments send both a 24h and
  // a 2h reminder. Without these the reminder window query keeps matching
  // the same appointment on every cron tick until it starts.
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?

  // Check-in ticket, same mechanism as WorkshopReservation/FormationReservation
  // (see lib/activities/check-in-code.js), prefixed "R-". Only minted once the
  // appointment reaches CONFIRMED, so holding one is evidence a deposit (or
  // the full price) was actually taken. Unlike a reservation there is no
  // seats concept — one appointment is one person, so check-in is a single
  // timestamp rather than a counter.
  checkInCode   String?   @unique
  checkedInAt   DateTime?
  checkedInById String?
  checkedInBy   User?     @relation("AppointmentCheckedInBy", fields: [checkedInById], references: [id])

  @@index([staffServiceId, startTime]) // conflict checks + calendar
  @@index([staffId, startTime]) // cross-service overlap checks
  @@index([userId, startTime]) // "my appointments"
  @@index([isDeleted, status, startTime]) // dashboard filters
  @@index([cancelledByUserId])
}

// A late cancellation request does not change the appointment or payment by
// itself. It gives the salon a durable review queue and an audit trail of the
// customer's stated exceptional circumstances.
model AppointmentCancellationRequest {
  id String @id @default(cuid())

  appointmentId String @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  requestedByUserId String
  requestedBy       User @relation("CancellationRequestSubmittedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reason            String
  status            AppointmentCancellationRequestStatus @default(PENDING)

  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedBy       User? @relation("CancellationRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  decisionNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
}

// The atelier/formation counterpart of AppointmentCancellationRequest above.
// Customers cannot self-cancel either flow (confirmed policy: the 50%
// deposit is non-refundable, and exceptions — medical, bereavement, genuine
// force majeure — are Marie's call case by case). Before this, the customer
// simply saw no way to cancel and no way to ask: a dead end that pushed
// every such case to an untracked phone call.
//
// Polymorphic on exactly one of workshopReservationId / formationReservationId,
// enforced by a raw-SQL CHECK constraint in the migration
// ("ReservationCancellationRequest_exactly_one_source") — same approach as
// Payment, since Prisma has no schema-level XOR.
model ReservationCancellationRequest {
  id String @id @default(cuid())

  workshopReservationId String?              @unique
  workshopReservation   WorkshopReservation? @relation(fields: [workshopReservationId], references: [id], onDelete: Cascade)

  formationReservationId String?               @unique
  formationReservation   FormationReservation? @relation(fields: [formationReservationId], references: [id], onDelete: Cascade)

  requestedByUserId String
  requestedBy       User   @relation("ReservationCancellationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reason            String
  status            ReservationCancellationRequestStatus @default(PENDING)

  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedBy       User?     @relation("ReservationCancellationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  decisionNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
}

// PAYMENT
// Polymorphic: exactly one of appointmentId / orderId / workshopReservationId
// / formationReservationId is set, enforced by a raw-SQL CHECK constraint
// added after the migration (see prisma/migrations/*/migration.sql for
// "Payment_exactly_one_source") — Prisma has no schema-level XOR.
model Payment {
  id                     String                @id @default(cuid())
  appointmentId          String?               @unique
  appointment            Appointment?          @relation(fields: [appointmentId], references: [id])
  orderId                String?               @unique
  order                  Order?                @relation(fields: [orderId], references: [id])
  workshopReservationId  String?               @unique
  workshopReservation    WorkshopReservation?  @relation(fields: [workshopReservationId], references: [id])
  formationReservationId String?               @unique
  formationReservation   FormationReservation? @relation(fields: [formationReservationId], references: [id])
  depositAmount          Decimal               @default(0)
  totalAmount            Decimal
  paidAmount             Decimal
  remainingAmount        Decimal
  paymentType            PaymentType
  status                 PaymentStatus
  paidAt                 DateTime?
  isDeleted              Boolean               @default(false)
  deletedAt              DateTime?
  // @unique is safe on a nullable column in Postgres — NULLs are never
  // considered duplicates of each other, so ON_SITE/cash payments (which
  // never set this) are unaffected. This turns the webhook's idempotency
  // check from a race-prone findFirst-then-create into a real DB guarantee:
  // a second concurrent insert with the same session id throws P2002 instead
  // of silently succeeding and double-fulfilling.
  transactionReference   String?               @unique

  // Durable refund-retry bookkeeping — see PaymentStatus.REFUND_PENDING/
  // REFUND_FAILED above and lib/payments/retry-failed-refunds.js. Cleared
  // implicitly by moving on to REFUNDED/PARTIALLY_REFUNDED; not reset to
  // null on success since a resolved failure history is still worth
  // keeping for reporting.
  refundFailureReason String?
  refundAttemptedAt   DateTime?
  refundRetryCount    Int       @default(0)

  // The exact amount (and a stable Stripe idempotency key) for the refund
  // operation currently in flight. Set atomically with status:
  // REFUND_PENDING, before the Stripe call — so a retry after a crash or a
  // failed attempt replays this exact amount instead of recomputing "what's
  // left" from the Transaction ledger, which would wrongly resolve to the
  // full outstanding balance whenever no REFUND row was ever written (the
  // very reason the payment is stuck). Cleared once the operation resolves
  // (REFUNDED/PARTIALLY_REFUNDED); kept through REFUND_FAILED so retries
  // keep using it. While either is set, no new refund may be started against
  // this payment — see the "already pending" guard at each call site.
  pendingRefundAmount         Decimal?
  pendingRefundIdempotencyKey String?
  // The credit note is always issued up front, inside the same DB
  // transaction that claims the cancellation/return — before the Stripe
  // call, which can fail or only resolve later via retry. Pinning its id
  // here is what lets the REFUND Transaction row created once Stripe (or
  // the retry cron) actually confirms still link back to it.
  pendingRefundCreditNoteId String?

  // Recorded here rather than on each of the 4 source models (Order,
  // WorkshopReservation, FormationReservation, Appointment) — Payment is
  // the one row every flow already creates, and Appointment in particular
  // has no price field of its own to sit a discount next to (it's derived
  // from StaffService.price at booking time). `totalAmount` above is
  // already the post-discount figure; this is purely for reporting which
  // code was used and how much it took off.
  promoCodeId    String?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  discountAmount Decimal    @default(0) @db.Decimal(10, 2)

  transactions Transaction[]
  invoice      Invoice?
  disputes     StripeDispute[]

  @@index([promoCodeId])
}

enum DisputeStatus {
  NEEDS_RESPONSE
  UNDER_REVIEW
  WARNING_NEEDS_RESPONSE
  WARNING_UNDER_REVIEW
  WARNING_CLOSED
  WON
  LOST
  CHARGE_REFUNDED
}

// Persistent dossier for a Stripe dispute/chargeback — before this, the only
// record was a best-effort staff alert email (see
// app/api/webhooks/stripe/route.js#handleChargeDisputeCreated), with no
// durable place to track who's handling it, what was submitted, or the
// eventual outcome. Created/updated by the charge.dispute.created /
// charge.dispute.updated / charge.dispute.closed webhook handlers; the
// dossier fields below (assignedStaff/responseSentAt/proof/conclusion) are
// filled in by staff from the dashboard.
model StripeDispute {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])

  stripeDisputeId String        @unique
  stripeChargeId  String?
  amount          Decimal
  reason          String? // Stripe's dispute reason code (e.g. "fraudulent", "product_not_received")
  status          DisputeStatus @default(NEEDS_RESPONSE)
  dueBy           DateTime? // evidence submission deadline from Stripe

  // The dossier itself — filled in by staff, not by the webhook.
  assignedStaffId          String?
  assignedStaff            User?     @relation("DisputeAssignee", fields: [assignedStaffId], references: [id])
  responseSentAt           DateTime? // when evidence was actually submitted to Stripe
  proofOfShipmentReference String? // tracking code / pickup confirmation cited in the response
  conclusion               String? // free-text outcome notes once resolved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
}

// PROMO CODE
// Reusable across customers (not single-use). Originally built to never
// auto-expire — only a manual `isActive` toggle retires one — per the
// client's explicit call; expiresAt/maxUses were added later (still the
// client's call) as an OPTIONAL cap, not a requirement: left null, a code
// behaves exactly as before (never expires, unlimited uses). `code` is
// stored uppercase so lookups are case-insensitive without a DB collation
// dependency.
model PromoCode {
  id             String        @id @default(cuid())
  code           String        @unique
  type           PromoCodeType
  value          Decimal       @db.Decimal(10, 2) // percentage points (0-100) or a flat EUR amount, per `type`
  minOrderAmount Decimal?      @db.Decimal(10, 2) // null = no minimum
  isActive       Boolean       @default(true)
  expiresAt      DateTime? // null = never expires
  maxUses        Int? // null = unlimited
  usedCount      Int           @default(0) // incremented atomically at booking time, see resolvePromoCode callers
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments              Payment[]
  orders                Order[]
  workshopReservations  WorkshopReservation[]
  formationReservations FormationReservation[]

  @@index([isActive])
}

// NUMBERING COUNTER
// Atomic per-key counter backing legally-gapless sequential numbering
// (invoices, credit notes — Belgian TVA law requires an unbroken sequence,
// not just "usually in order"). One row per series+year, e.g. "invoice-2026".
// Incremented via a single UPDATE...RETURNING inside the SAME transaction as
// the document it numbers (see lib/invoicing.js), so a rolled-back
// transaction never burns a number.
model NumberingCounter {
  key        String @id
  lastNumber Int    @default(0)
}

// INVOICE
// One per Payment, created the moment a sale is actually settled (Stripe
// payment confirmed, or cash/card collected in person) — never at checkout
// time, since an unpaid/abandoned order or appointment must never consume a
// number. Seller/customer/line data is a frozen snapshot taken at issue
// time (copied in, never joined live) because the invoice must keep
// reflecting what was true when issued even if the product, customer, or
// salon info changes afterwards.
model Invoice {
  id     String        @id @default(cuid())
  number String        @unique // "2026-000001" — year + gapless in-year sequence
  source InvoiceSource

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  issuedAt DateTime @default(now())

  sellerName      String
  sellerAddress   String?
  sellerVatNumber String?

  customerName      String
  customerEmail     String
  customerVatNumber String? // Client TVA number (copied from User.vatNumber at invoice time)
  customerAddress   String?

  // B2B snapshot — populated when the buyer is a company (see
  // BillingProfile). Peppol network delivery is Phase B (not built); until
  // then a B2B invoice is flagged for manual accountant-software entry —
  // see customerType on the dashboard invoices list.
  customerType           InvoiceCustomerType @default(B2C)
  customerLegalName      String?
  customerContactName    String?
  customerRegistrationNo String?
  purchaseOrderReference String?

  subtotalExclVat Decimal      @db.Decimal(10, 2)
  vatRate         Decimal      @default(21) @db.Decimal(4, 2)
  vatAmount       Decimal      @db.Decimal(10, 2)
  totalInclVat    Decimal      @db.Decimal(10, 2)
  taxCountryCode  String       @default("BE")
  vatTreatment    VatTreatment @default(DOMESTIC)
  taxNote         String?

  // Set once this invoice has been created as an order in Billit
  // (POST /v1/orders — see lib/billit.js). Billit's own dashboard is where
  // staff finish the actual Peppol/e-mail dispatch, so these two fields only
  // ever record "was it handed to Billit", never a delivery outcome.
  billitOrderId String?
  billitSentAt  DateTime?

  lines       InvoiceLine[]
  creditNotes CreditNote[]

  @@index([paymentId])
}

// INVOICE LINE
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)

  // Article 226(8) of directive 2006/112/CE requires the unit price
  // EXCLUDING VAT on every line. unitPrice above is VAT-inclusive (it is the
  // amount actually charged), so the net twin is stored rather than left to
  // whoever renders the document to divide.
  //
  // 4 decimals on the unit preserve an accurate HT extraction from the TTC
  // amount charged. The line total is a money figure instead, allocated by
  // issueInvoice so the lines sum to Invoice.subtotalExclVat to the cent.
  unitPriceExclVat Decimal @default(0) @db.Decimal(10, 4)
  lineTotalExclVat Decimal @default(0) @db.Decimal(10, 2)
}

// CREDIT NOTE
// Issued alongside a refund whenever an already-invoiced order/appointment
// is cancelled — never edits or deletes the original Invoice, Belgian law
// requires the correction to be its own numbered document. Own gapless
// sequence, separate counter from Invoice's.
model CreditNote {
  id     String @id @default(cuid())
  number String @unique // "NC2026-000001"

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  reason       String?
  issuedAt     DateTime @default(now())
  // HT/TVA/TTC breakdown of the credited amount, at the original invoice's
  // rate — a partial credit needs its own visible split, not just a TTC
  // figure (spec: "préciser motif, ... HT, TVA, TTC et taux").
  subtotalExclVat Decimal @db.Decimal(10, 2)
  vatRate         Decimal @db.Decimal(4, 2)
  vatAmount       Decimal @db.Decimal(10, 2)
  totalInclVat    Decimal @db.Decimal(10, 2)

  returnRequest ReturnRequest?
  transaction   Transaction?

  @@index([invoiceId])
}

// CASH SESSION
// A daily till open/close boundary — before this, every CASH POS sale was
// tracked individually (Transaction.cashReceived/changeGiven) but nothing
// gave a running expected total or a counted-vs-expected reconciliation at
// end of day, so a shortfall was only ever findable by recounting every
// sale one by one.
model CashSession {
  id String @id @default(cuid())

  openedAt     DateTime @default(now())
  openedById   String
  openedBy     User     @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  openingFloat Decimal  @db.Decimal(10, 2)

  closedAt     DateTime?
  closedById   String?
  closedBy     User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  // expected = openingFloat + sum(CASH transactions during the session).
  // Both null while the session is open — filled in atomically at close.
  expectedCash Decimal?  @db.Decimal(10, 2)
  countedCash  Decimal?  @db.Decimal(10, 2)
  variance     Decimal?  @db.Decimal(10, 2)
  note         String?

  transactions Transaction[]

  @@index([closedAt])
}

// TRANSACTION
model Transaction {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])

  // Set at sale time when a CashSession is open (POS CASH sales only) — a
  // sale never blocks on this being unset, it's just left unassigned and
  // reconciled manually if no session was open.
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  // Only ever set on a REFUND row — the document that justifies this money
  // leaving. Nullable/SetNull: a CreditNote is never deleted for a refund
  // row to keep existing, and a refund recorded before this link existed
  // (or done manually outside Stripe) can be missing one until backfilled.
  creditNoteId String?     @unique
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  amount                  Decimal
  method                  TransactionMethod
  transactionType         TransactionType
  paidAt                  DateTime
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  // Receipt / transaction identifier entered after a physical terminal
  // refund. Stripe refunds keep their identifiers in the Stripe fields.
  manualReference         String?
  // Cash-drawer audit trail for CASH POS sales — what the cashier actually
  // received and how much change they handed back, so a till shortfall can
  // be traced to a specific sale instead of only ever showing the sale total.
  cashReceived            Decimal?
  changeGiven             Decimal?
  createdAt               DateTime          @default(now())
  isDeleted               Boolean           @default(false)
  deletedAt               DateTime?

  @@index([paymentId])
}

// CONTRACT
model Contract {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  type                 ContractType
  commissionPercentage Float?
  fixedRent            Decimal?
  startDate            DateTime
  endDate              DateTime?
  status               ContractStatus
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  rentalRequest RentalRequest?
}

// WORKING HOUR
model WorkingHour {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  day       WeekDay
  startTime String
  endTime   String
  isClosed  Boolean @default(false)
}

// TIME OFF
model TimeOff {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  startDate  DateTime
  endDate    DateTime
  isFullDay  Boolean @default(false)
  reason     String?
}

// REVIEW
model Review {
  id String @id @default(cuid())

  userId        String
  appointmentId String @unique

  user        User        @relation(fields: [userId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// NOTIFICATION
model Notification {
  id String @id @default(cuid())

  userId        String
  appointmentId String?

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  type    NotificationType
  title   String
  message String

  status    NotificationStatus
  isRead    Boolean            @default(false)
  actionUrl String?
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, isRead])
}

// NEWSLETTER
model Newsletter {
  id String @id @default(cuid())

  title       String
  subject     String
  content     String
  status      NewsletterStatus
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  // Null = created by OWNER/ADMIN; non-null = that staff member authored it.
  // STAFF may only edit/delete/send their own drafts, and sendNewsletter
  // limits their audience to opted-in customers linked to their confirmed or
  // completed appointments/formations. OWNER/ADMIN retain the salon-wide audience.
  createdByStaffId String?
  createdByStaff   Staff?  @relation(fields: [createdByStaffId], references: [id])

  recipients NewsletterRecipient[]

  @@index([createdByStaffId])
}

// NEWSLETTER RECIPIENT
model NewsletterRecipient {
  id String @id @default(cuid())

  newsletterId String
  userId       String

  newsletter Newsletter @relation(fields: [newsletterId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  status   RecipientStatus
  openedAt DateTime?

  @@unique([newsletterId, userId])
}

// RENTAL REQUEST
model RentalRequest {
  id             String              @id @default(cuid())
  userId         String?
  user           User?               @relation(fields: [userId], references: [id])
  rentalType     String
  startDate      DateTime
  desiredPace    String?
  commissionType CommissionType
  status         RentalRequestStatus
  message        String?
  ownerResponse  String?
  specialty      String?
  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  contractId     String?             @unique
  contract       Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
}

// SALON GALLERY
model SalonGallery {
  id String @id @default(cuid())

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])

  image     String
  createdAt DateTime @default(now())
}

// PASSWORD RESET TOKEN
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// EMAIL VERIFICATION TOKEN
model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Set only for tokens issued mid-checkout (guest order/reservation awaiting
  // confirmation before payment can start) — null for plain registration
  // tokens. Looked up from this row server-side on verify, never trusted
  // from a URL param, so a hand-edited link can't ride someone else's order.
  resumeType String? // "ORDER" | "WORKSHOP" | "FORMATION"
  resumeId   String?

  @@index([email])
  @@index([expiresAt])
}
