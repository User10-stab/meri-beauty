{
  "name": "meri-beauty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev ",
    "dev:stripe": "node scripts/dev-with-stripe-webhooks.mjs",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/reservation-payment.test.js && npm run test:critical",
    "test:critical": "vitest run --reporter=default --reporter=junit --reporter=json --outputFile.junit=test-results/critical.xml --outputFile.json=test-results/critical.json",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.mjs --reporter=default",
    "audit:prod": "npm audit --omit=dev && npm run lint && npm test && npm run build",
    "seed": "node prisma/seed.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
